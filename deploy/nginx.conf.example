# Deck Loader — nginx server block for the static SPA.
#
# Install:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/presentations
#   sudo ln -s /etc/nginx/sites-available/presentations /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# HTTPS: once DNS points here, run
#   sudo apt install certbot python3-certbot-nginx
#   sudo certbot --nginx -d your.domain.tld
# certbot rewrites this file and installs a renewal timer; do not hand-write the
# TLS block.

server {
    listen 80;
    listen [::]:80;

    # TODO: your domain, or "_" while there is none.
    server_name your.domain.tld;

    # Must match WEB_ROOT in deploy/deploy.sh.
    root /var/www/presentations;
    index index.html;

    charset utf-8;

    # --- compression -------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/manifest+json
        image/svg+xml
        font/woff
        font/woff2;

    # --- caching -----------------------------------------------------------

    # Hashed build output never changes under the same name.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # Slide PDFs are replaced in place, so cache them briefly rather than forever.
    location /pdf/ {
        expires 1h;
        add_header Cache-Control "public, max-age=3600";
        add_header Content-Disposition "inline";
        types { application/pdf pdf; }
        try_files $uri =404;
    }

    # The shell must be revalidated, or clients keep an old bundle forever.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # --- SPA fallback ------------------------------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # A missing hashed asset is a 404, never the HTML shell.
    location ~* \.(?:js|css|woff2?|png|jpe?g|svg|webp|ico)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
    }

    error_page 404 /index.html;
}
